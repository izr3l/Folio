{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Folio",
    "version": "0.1.0",
    "identifier": "com.folio.reader",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Folio",
                "width": 1120,
                "height": 760,
                "minWidth": 760,
                "minHeight": 520,
                "resizable": true
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "windows-hooks.nsh"
            }
        },
        "fileAssociations": [
            {
                "ext": [
                    "md",
                    "markdown"
                ],
                "name": "Folio.Markdown",
                "description": "Markdown document",
                "mimeType": "text/markdown",
                "role": "Viewer"
            }
        ]
    }
}